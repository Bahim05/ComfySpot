# Salin file ini menjadi .env lalu isi. File .env tidak boleh di-commit.
# PROJECT_ID harus sama persis di hub, simulator, dan halaman sensor, dan harus unik per kelompok.
PROJECT_ID=isi_id_unik_kelompok

# Broker publik HiveMQ (tanpa akun). Untuk broker pribadi, ubah host, port, dan isi username serta password.
BROKER_HOST=broker.hivemq.com
BROKER_PORT=8883
BROKER_TLS=true
BROKER_USERNAME=
BROKER_PASSWORD=
